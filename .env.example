# ---------------------------------------------------------------------------
# Compañía de Bomberos France N°3 — variables del frontend
# ---------------------------------------------------------------------------
# Copie este archivo como `.env.local` y complete los valores.
# Todas se leen SOLO en el servidor: ninguna llega al navegador.
# (Ninguna lleva el prefijo NEXT_PUBLIC_, y así debe quedar.)

# --- Amazon Cognito (autenticación) ----------------------------------------
# Región del User Pool (backend/serverless.yml → provider.region).
COGNITO_REGION=us-east-1

# ID del User Pool. Ej.: us-east-1_AbCdEfGhI
# Salida `UserPoolId` de `serverless deploy` (o Cognito → User pools).
COGNITO_USER_POOL_ID=us-east-1_S6cl2E8kC

# ID del App Client del User Pool.
# Salida `UserPoolClientId` de `serverless deploy` (o Cognito → App clients).
COGNITO_CLIENT_ID=18v4fb8bshdtqa5aar2qao7i1f

# Secreto del App Client. El del backend se creó SIN secreto
# (GenerateSecret: false): dejar vacío.
COGNITO_CLIENT_SECRET=

# --- API Gateway -----------------------------------------------------------
# URL base del gateway, sin barra final. La de `dev` está en backend/README.md.
API_GATEWAY_URL=https://3fbn9ktlw8.execute-api.us-east-1.amazonaws.com/dev

# Token que se envía en Authorization al gateway:
#   access  → authorizer JWT de HTTP API
#   id      → authorizer de Cognito User Pools en REST API
# El backend usa un authorizer COGNITO_USER_POOLS y espera el IdToken.
API_GATEWAY_TOKEN=idaccess

# Clave del header `x-api-key`, si el gateway la exige. Opcional.
API_GATEWAY_KEY=
